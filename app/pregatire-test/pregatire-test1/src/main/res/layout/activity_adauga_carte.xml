<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AdaugaCarte">

    <EditText
        android:id="@+id/ilie_victor_et_titlu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/titlu" />

    <EditText
        android:id="@+id/ilie_victor_et_an"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="@string/anul_aparitiei" />

    <Spinner
        android:id="@+id/ilie_victor_sp_editura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/optiuni_editura" />

    <CheckBox
        android:id="@+id/ilie_victor_cb_valabila"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/este_valabila" />

    <Button
        android:id="@+id/ilie_victor_btn_salveaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salveaza" />

</LinearLayout>